{
  "name": "getlee",
  "version": "0.0.1",
  "description": "Turn any prompt into a link that opens Cloudflare's Agent Lee with it ready to send.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "vite build --config client/vite.config.ts",
    "dev": "vite build --config client/vite.config.ts && wrangler dev --port 8790",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "check": "bash scripts/gate.sh"
  },
  "dependencies": {
    "@effect/platform-browser": "4.0.0",
    "effect": "4.0.0",
    "foldkit": "0.168.0",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261012.1",
    "@foldkit/vite-plugin": "0.26.1",
    "@tailwindcss/vite": "4.3.3",
    "happy-dom": "^20.14.5",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "vite": "8.3.3",
    "vitest": "^5.0.3",
    "wrangler": "4.149.0"
  },
  "allowScripts": {
    "workerd@1.20261006.1": true,
    "esbuild@0.28.2": true
  }
}
